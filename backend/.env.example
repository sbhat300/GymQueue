MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gymqueue
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEFAULT_GRACE_PERIOD_SECONDS=120
DEFAULT_REST_PERIOD_SECONDS=300
DEFAULT_MAX_RESTS=6
SCHEDULER_INTERVAL_SECONDS=2
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- vision service (../vision) ----
VISION_URL=http://localhost:8001
VISION_API_KEY=change-me                 # must match the vision service's VISION_API_KEY
VISION_EVENTS_API_KEY=change-me-too      # must match the vision service's BACKEND_API_KEY

# ---- busy times / estimated wait ----
GYM_TIMEZONE=America/New_York
STATS_SAMPLE_INTERVAL_SECONDS=60
STATS_HISTORY_DAYS=28
