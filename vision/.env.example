# ---- this service ----
VISION_API_KEY=change-me                 # = VISION_API_KEY in backend/.env (backend calls /enroll, /machines/*/rest)
LOCALHOST_SKIPS_KEY=true                 # this laptop doesn't need the key (set false if exposed via a tunnel)
PORT=8001                                # the GymQueue backend uses 8000 and expects us on 8001
CAMERAS_FILE=cameras.json

# ---- where face embeddings are stored ----
FACE_STORE=local                         # local (data/faces.json) | supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # service role, server-side only - never ship to the browser
SUPABASE_FACE_TABLE=face_embeddings

# ---- where presence events go (the GymQueue backend) ----
BACKEND_URL=http://localhost:8000        # empty = just log events
BACKEND_EVENTS_PATH=/api/vision/events
BACKEND_API_KEY=change-me-too            # = VISION_EVENTS_API_KEY in backend/.env

# ---- tuning ----
MATCH_THRESHOLD=0.45                     # ArcFace cosine similarity to count as a match
AWAY_GRACE_S=15                          # off-camera this long = left (the backend then applies its own grace)
REST_DEFAULT_S=120                       # rest length if the backend doesn't send one
MAX_RESTS=6
ARRIVE_HITS=3                            # sightings within ARRIVE_WINDOW_S before "user_arrived"
ARRIVE_WINDOW_S=4
MAX_FPS=5                                # per camera; CPU budget
MIN_FACE_PX=20                           # ignore faces smaller than this (px wide)
DET_SIZE=640                             # 960 finds smaller faces in full frames, ~35% more CPU
INSIGHTFACE_MODEL=buffalo_l              # buffalo_s is faster/less accurate on a slow laptop

# ---- vitals (heart rate during shoulder-press sets, via Presage) ----
PRESAGE_API_KEY=                         # blank = heart rate tracking disabled
PRESAGE_BUDGET_S=1200                    # hard cap on seconds of footage submitted this run (1 Presage credit = 30s)
VITALS_WINDOW_S=15                       # seconds of footage per heart-rate reading
