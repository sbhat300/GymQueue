# ---- this service ----
VISION_API_KEY=change-me                 # backend sends this to call /enroll, /machines/*/rest, ...
PORT=8000
CAMERAS_FILE=cameras.json

# ---- where face embeddings are stored ----
FACE_STORE=local                         # local (data/faces.json) | supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # service role, server-side only - never ship to the browser
SUPABASE_FACE_TABLE=face_embeddings

# ---- where presence events go (the Next.js backend) ----
BACKEND_URL=                             # e.g. http://localhost:3000 ; empty = just log events
BACKEND_EVENTS_PATH=/api/vision/events
BACKEND_API_KEY=change-me-too            # sent as "Authorization: Bearer ..."

# ---- tuning ----
MATCH_THRESHOLD=0.45                     # ArcFace cosine similarity to count as a match
AWAY_GRACE_S=30                          # how long someone can be off-camera before the machine is released
REST_DEFAULT_S=120                       # rest length if the backend doesn't send one
MAX_RESTS=6
ARRIVE_HITS=3                            # sightings within ARRIVE_WINDOW_S before "user_arrived"
ARRIVE_WINDOW_S=4
MAX_FPS=5                                # per camera; CPU budget
MIN_FACE_PX=20                           # ignore faces smaller than this (px wide)
DET_SIZE=640                             # 960 finds smaller faces in full frames, ~35% more CPU
INSIGHTFACE_MODEL=buffalo_l              # buffalo_s is faster/less accurate on a slow laptop
